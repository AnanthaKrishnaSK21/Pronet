# Database Configuration
# Set USE_MYSQL=True to use MySQL (make sure the MySQL database exists)
USE_MYSQL=False

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pronet
DB_PORT=3306

# Server Port (default 8000 or 5000)
PORT=5000
SECRET_KEY=django-insecure-pronet-secret-key-change-in-production
DEBUG=True
